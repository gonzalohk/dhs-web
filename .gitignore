# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# Environment variables (secrets). Only the template is committed.
.env*
!.env.example

# Deployment
.vercel
.wrangler/

# Supabase CLI local state (migrations in supabase/migrations/ are committed)
supabase/.branches/
supabase/.temp/

# Tests and audits
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.lighthouseci/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Certificates and keys
*.pem
*.key

# Claude Code: personal settings stay local (shared skills in .claude/skills are committed)
.claude/settings.local.json

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
*.tmp
