# Public site URL (canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (content, inquiries, staff sign-in). Without these, the site uses placeholder
# content and, outside production, logs inquiries to the server console instead of storing them.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Contact form email (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Random secret used to hash visitor IPs for rate limiting
IP_HASH_SALT=

# WhatsApp number in international format without "+" (Bolivia: 591 + 8 digits)
NEXT_PUBLIC_WHATSAPP_NUMBER=59170000000

# Optional: Cloudinary cloud name (images) and Google Tag Manager container (GA4)
NEXT_PUBLIC_CLOUDINARY_CLOUD=
NEXT_PUBLIC_GTM_ID=
