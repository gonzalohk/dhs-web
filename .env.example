# Public site URL (canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (content, inquiries, staff sign-in). Without these, the site uses placeholder
# content and, outside production, logs inquiries to the server console instead of storing them.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Contact form email (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Random secret used to hash visitor IPs for rate limiting
IP_HASH_SALT=

# Optional: Google Tag Manager container (GA4)
NEXT_PUBLIC_GTM_ID=

# Optional, tests only: a staff account used by the signed-in editor e2e tests (needs Supabase above)
# E2E_STAFF_EMAIL=
# E2E_STAFF_PASSWORD=
